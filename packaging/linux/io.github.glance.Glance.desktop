[Desktop Entry]
Type=Application
Name=Glance
GenericName=Image Viewer
Comment=View, zoom, rotate and crop images
Exec=glance %F
Icon=io.github.glance.Glance
Terminal=false
Categories=Graphics;Viewer;
Keywords=image;photo;picture;viewer;
StartupWMClass=io.github.glance.Glance
MimeType=image/png;image/apng;image/jpeg;image/gif;image/webp;image/bmp;image/x-bmp;image/vnd.microsoft.icon;image/x-icon;image/tiff;image/x-tga;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/qoi;image/vnd.radiance;image/x-exr;image/vnd-ms.dds;image/x-dds;image/svg+xml;image/svg+xml-compressed;
